generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  BOOKED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
  REFUNDED
}

enum UserRole {
  PLATFORM_OWNER
  ORG_OWNER
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum HousekeepingStatus {
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
  OUT_OF_SERVICE
}

enum HousekeepingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PaymentProvider {
  MOCK
  CASH
  CARD
  UPI
  RAZORPAY
  STRIPE
}

enum PaymentTransactionStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ChannelProvider {
  MOCK
  ZODOMUS
  SITEMINDER
  BOOKING_COM
  AIRBNB
}

enum ChannelConnectionStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum ChannelSyncType {
  INVENTORY
  RATES
  BOOKINGS
}

enum ChannelSyncStatus {
  QUEUED
  SUCCEEDED
  PARTIAL_FAILED
  FAILED
}

enum InventorySyncRowStatus {
  SUCCEEDED
  FAILED
}

enum ProviderReservationIntakeStatus {
  FETCHED
  IMPORTED
  FAILED
  SKIPPED
}

enum WebhookDomain {
  PAYMENT
  CHANNEL
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum BackgroundJobType {
  WEBHOOK_PROCESS
  CHANNEL_SYNC
  NOTIFICATION_SEND
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  DEAD_LETTER
}

enum PricingRuleType {
  WEEKEND
  DATE_RANGE
  OCCUPANCY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CHECK_IN
  CHECK_OUT
  PAYMENT_COLLECT
  PAYMENT_REFUND
  CHANNEL_SYNC
}

enum WhatsAppConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  QR_REQUIRED
  CONNECTED
  RECONNECTING
  DISCONNECTED
  LOGGED_OUT
  ERROR
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  REACTION
  SYSTEM
  UNSUPPORTED
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum EmailProviderType {
  GMAIL
  MICROSOFT
  IMAP
  MANUAL
}

enum EmailConnectionStatus {
  CONNECTING
  CONNECTED
  REAUTH_REQUIRED
  RECONNECTING
  ERROR
  DISCONNECTED
}

enum GoogleCalendarConnectionStatus {
  CONNECTED
  ERROR
  REAUTH_REQUIRED
  DISCONNECTED
}

enum IncomingEmailStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  NEEDS_REVIEW
  IGNORED
  FAILED
}

enum EmailCategory {
  BOOKING_CONFIRMATION
  BOOKING_MODIFICATION
  BOOKING_CANCELLATION
  BOOKING_ENQUIRY
  PAYMENT_NOTIFICATION
  OTA_MESSAGE
  GUEST_MESSAGE
  OFFER
  PROMOTION
  GENERAL
  UNKNOWN
}

enum EmailSource {
  BOOKING_COM
  AIRBNB
  EXPEDIA
  MAKEMYTRIP
  GOIBIBO
  AGODA
  WEBSITE
  DIRECT_GUEST
  OTHER
  UNKNOWN
}

enum ParserType {
  DETERMINISTIC
  AI
  MANUAL
}

enum AutomationDecision {
  CREATE_RESERVATION
  UPDATE_RESERVATION
  CANCEL_RESERVATION
  CREATE_ENQUIRY
  ATTACH_TO_RESERVATION
  REVIEW
  IGNORE
  NO_ACTION
}

model Guest {
  id        String    @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name      String    @db.VarChar(120)
  phone     String    @db.VarChar(30)
  email     String?   @db.VarChar(160)
  idProof   String    @map("id_proof") @db.VarChar(120)
  address   String    @db.Text
  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservationGroups ReservationGroup[] @relation("PrimaryGuestReservationGroups")
  whatsappConversations WhatsAppConversation[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([phone])
  @@index([email])
  @@map("guests")
}

model Organization {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(160)
  status    String     @default("ACTIVE") @db.VarChar(40)
  billingEmail String? @map("billing_email") @db.VarChar(160)
  properties Property[]
  users     User[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@map("organizations")
}

model Property {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  name           String         @db.VarChar(160)
  code           String         @unique @db.VarChar(40)
  phone          String?        @db.VarChar(30)
  email          String?        @db.VarChar(160)
  address        String         @db.Text
  timezone       String         @default("Asia/Kolkata") @db.VarChar(80)
  defaultCheckInTime  String    @default("12:00") @map("default_check_in_time") @db.VarChar(5)
  defaultCheckOutTime String    @default("11:00") @map("default_check_out_time") @db.VarChar(5)
  isActive       Boolean        @default(true) @map("is_active")
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  guests         Guest[]
  roomCategories RoomCategory[]
  ratePlans      RatePlan[]
  rooms          Room[]
  roomOutOfServicePeriods RoomOutOfServicePeriod[]
  reservationGroups ReservationGroup[]
  reservationRooms ReservationRoom[]
  pricingRules   PricingRule[]
  users          User[]
  housekeepingTasks HousekeepingTask[]
  channelConnections ChannelConnection[]
  inventoryCalendar InventoryCalendar[]
  inventoryBlocks InventoryBlock[]
  webhookEvents  WebhookEvent[]
  backgroundJobs BackgroundJob[]
  providerReservationIntakeRecords ProviderReservationIntakeRecord[]
  whatsappConnections WhatsAppConnection[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages WhatsAppMessage[]
  emailConnections EmailConnection[]
  googleCalendarConnections GoogleCalendarConnection[]
  incomingEmails IncomingEmail[]
  bookingEnquiries BookingEnquiry[]
  expenses       Expense[]
  images         PropertyImage[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([isActive])
  @@map("properties")
}

model WhatsAppConnection {
  id                 String                  @id @default(uuid()) @db.Uuid
  propertyId         String                  @map("property_id") @db.Uuid
  organizationId     String?                 @map("organization_id") @db.Uuid
  status             WhatsAppConnectionStatus @default(NOT_CONNECTED)
  phoneNumber        String?                 @map("phone_number") @db.VarChar(40)
  phoneE164          String?                 @map("phone_e164") @db.VarChar(40)
  whatsappJid        String?                 @map("whatsapp_jid") @db.VarChar(120)
  displayName        String?                 @map("display_name") @db.VarChar(160)
  sessionGeneration  Int                     @default(1) @map("session_generation")
  lastConnectedAt    DateTime?               @map("last_connected_at")
  lastDisconnectedAt DateTime?               @map("last_disconnected_at")
  lastErrorCode      String?                 @map("last_error_code") @db.VarChar(80)
  lastErrorMessage   String?                 @map("last_error_message") @db.Text
  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authRecords        WhatsAppAuthRecord[]
  conversations      WhatsAppConversation[]
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@unique([propertyId])
  @@index([organizationId, status])
  @@index([propertyId, status])
  @@map("whatsapp_connections")
}

model WhatsAppAuthRecord {
  id                String             @id @default(uuid()) @db.Uuid
  connectionId      String             @map("connection_id") @db.Uuid
  authKey           String             @map("auth_key") @db.VarChar(240)
  encryptedValue    Bytes              @map("encrypted_value")
  encryptionVersion Int                @default(1) @map("encryption_version")
  connection        WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([connectionId, authKey])
  @@index([connectionId])
  @@map("whatsapp_auth_records")
}

model WhatsAppConversation {
  id                 String              @id @default(uuid()) @db.Uuid
  propertyId         String              @map("property_id") @db.Uuid
  organizationId     String?             @map("organization_id") @db.Uuid
  connectionId       String              @map("connection_id") @db.Uuid
  remoteJid          String              @map("remote_jid") @db.VarChar(160)
  phoneE164          String?             @map("phone_e164") @db.VarChar(40)
  displayName        String?             @map("display_name") @db.VarChar(160)
  profilePhotoUrl    String?             @map("profile_photo_url") @db.Text
  guestId            String?             @map("guest_id") @db.Uuid
  reservationGroupId String?             @map("reservation_group_id") @db.Uuid
  isGroup            Boolean             @default(false) @map("is_group")
  unreadCount        Int                 @default(0) @map("unread_count")
  lastMessageId      String?             @map("last_message_id") @db.Uuid
  lastMessagePreview String?             @map("last_message_preview") @db.VarChar(500)
  lastMessageAt      DateTime?           @map("last_message_at")
  archived           Boolean             @default(false)
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  connection         WhatsAppConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  guest              Guest?              @relation(fields: [guestId], references: [id], onDelete: SetNull)
  reservationGroup   ReservationGroup?   @relation(fields: [reservationGroupId], references: [id], onDelete: SetNull)
  messages           WhatsAppMessage[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([connectionId, remoteJid])
  @@index([propertyId, lastMessageAt])
  @@index([organizationId, propertyId])
  @@index([guestId])
  @@index([reservationGroupId])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id                String                   @id @default(uuid()) @db.Uuid
  propertyId        String                   @map("property_id") @db.Uuid
  organizationId    String?                  @map("organization_id") @db.Uuid
  conversationId    String                   @map("conversation_id") @db.Uuid
  whatsappMessageId String                   @map("whatsapp_message_id") @db.VarChar(180)
  remoteJid         String                   @map("remote_jid") @db.VarChar(160)
  direction         WhatsAppMessageDirection
  type              WhatsAppMessageType
  status            WhatsAppMessageStatus
  body              String?                  @db.Text
  quotedWhatsappId  String?                  @map("quoted_whatsapp_id") @db.VarChar(180)
  fromMe            Boolean                  @map("from_me")
  whatsappTimestamp DateTime                 @map("whatsapp_timestamp")
  receivedAt        DateTime                 @default(now()) @map("received_at")
  deliveredAt       DateTime?                @map("delivered_at")
  readAt            DateTime?                @map("read_at")
  rawType           String?                  @map("raw_type") @db.VarChar(80)
  property          Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  conversation      WhatsAppConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@unique([conversationId, whatsappMessageId])
  @@index([propertyId, whatsappTimestamp])
  @@index([organizationId, propertyId])
  @@index([conversationId, whatsappTimestamp])
  @@map("whatsapp_messages")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  propertyId   String?   @map("property_id") @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(160)
  passwordHash String    @map("password_hash") @db.Text
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true) @map("is_active")
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  auditLogs    AuditLog[]
  refreshSessions RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([propertyId])
  @@index([role])
  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Text
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(80)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique @db.VarChar(160)
  userId       String?  @map("user_id") @db.Uuid
  scope        String   @db.VarChar(80)
  requestHash  String   @map("request_hash") @db.VarChar(128)
  responseBody Json     @map("response_body")
  statusCode   Int      @default(200) @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([scope])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  propertyId String?     @map("property_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(80)
  entityId   String?     @map("entity_id") @db.VarChar(120)
  summary    String      @db.VarChar(240)
  metadata   Json?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([propertyId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RoomCategory {
  id          String     @id @default(uuid()) @db.Uuid
  propertyId  String     @map("property_id") @db.Uuid
  name        String     @db.VarChar(80)
  code        String     @db.VarChar(40)
  description String?    @db.Text
  maxOccupancy Int       @default(2) @map("max_occupancy")
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  ratePlans   RatePlan[]
  rooms       Room[]
  reservationRooms ReservationRoom[]
  channelRoomMappings ChannelRoomMapping[]
  inventoryCalendar InventoryCalendar[]
  inventoryBlocks InventoryBlock[]
  images      RoomCategoryImage[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([propertyId, code])
  @@index([propertyId])
  @@map("room_categories")
}

model RatePlan {
  id             String       @id @default(uuid()) @db.Uuid
  propertyId     String       @map("property_id") @db.Uuid
  roomCategoryId String       @map("room_category_id") @db.Uuid
  name           String       @db.VarChar(100)
  code           String       @db.VarChar(40)
  baseRate       Decimal      @map("base_rate") @db.Decimal(10, 2)
  currency       String       @default("INR") @db.VarChar(3)
  isActive       Boolean      @default(true) @map("is_active")
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  roomCategory   RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Restrict)
  reservationRooms ReservationRoom[]
  pricingRules   PricingRule[]
  channelRateMappings ChannelRateMapping[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([propertyId, code])
  @@index([propertyId])
  @@index([roomCategoryId])
  @@map("rate_plans")
}

model PricingRule {
  id                 String          @id @default(uuid()) @db.Uuid
  propertyId         String          @map("property_id") @db.Uuid
  ratePlanId         String          @map("rate_plan_id") @db.Uuid
  name               String          @db.VarChar(120)
  type               PricingRuleType
  adjustmentPercent  Decimal         @map("adjustment_percent") @db.Decimal(5, 2)
  startDate          DateTime?       @map("start_date") @db.Date
  endDate            DateTime?       @map("end_date") @db.Date
  occupancyThreshold Int?            @map("occupancy_threshold")
  isActive           Boolean         @default(true) @map("is_active")
  property           Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ratePlan           RatePlan        @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([ratePlanId])
  @@index([type])
  @@index([isActive])
  @@map("pricing_rules")
}

model Room {
  id            String     @id @default(uuid()) @db.Uuid
  propertyId    String     @map("property_id") @db.Uuid
  roomCategoryId String    @map("room_category_id") @db.Uuid
  roomNumber    String     @map("room_number") @db.VarChar(20)
  status        RoomStatus @default(AVAILABLE)
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  roomCategory  RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Restrict)
  outOfServicePeriods RoomOutOfServicePeriod[]
  reservationRooms ReservationRoom[]
  housekeepingTasks HousekeepingTask[]
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@index([roomCategoryId])
  @@index([status])
  @@map("rooms")
}

model RoomOutOfServicePeriod {
  id         String   @id @default(uuid()) @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  fromDate   DateTime @map("from_date") @db.Date
  toDate     DateTime @map("to_date") @db.Date
  reason     String   @db.VarChar(180)
  notes      String?  @db.Text
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([roomId, fromDate, toDate])
  @@index([propertyId, fromDate, toDate])
  @@map("room_out_of_service_periods")
}

model ReservationGroup {
  id                         String            @id @default(uuid()) @db.Uuid
  propertyId                 String            @map("property_id") @db.Uuid
  primaryGuestId            String?           @map("primary_guest_id") @db.Uuid
  channelConnectionId       String?           @map("channel_connection_id") @db.Uuid
  externalReservationId     String            @map("external_reservation_id") @db.VarChar(160)
  externalReservationVersion String?          @map("external_reservation_version") @db.VarChar(160)
  externalStatus            String?           @map("external_status") @db.VarChar(80)
  source                    String?           @db.VarChar(80)
  currency                  String?           @db.VarChar(8)
  totalAmount               Decimal?          @map("total_amount") @db.Decimal(10, 2)
  status                    BookingStatus     @default(BOOKED) @map("reservation_status")
  remarks                   String?           @db.Text
  bookedAt                  DateTime?         @map("booked_at")
  modifiedAt                DateTime?         @map("modified_at")
  rawPayload                Json?             @map("raw_payload")
  property                  Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  primaryGuest              Guest?            @relation("PrimaryGuestReservationGroups", fields: [primaryGuestId], references: [id], onDelete: SetNull)
  channelConnection         ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  rooms                     ReservationRoom[]
  whatsappConversations     WhatsAppConversation[]
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  @@unique([channelConnectionId, externalReservationId])
  @@index([propertyId])
  @@index([primaryGuestId])
  @@index([channelConnectionId])
  @@index([status])
  @@index([externalStatus])
  @@map("reservation_groups")
}

model InventoryCalendar {
  id             String       @id @default(uuid()) @db.Uuid
  propertyId     String       @map("property_id") @db.Uuid
  roomCategoryId String       @map("room_category_id") @db.Uuid
  stayDate       DateTime     @map("stay_date") @db.Date
  totalRooms     Int          @default(0) @map("total_rooms")
  blockedRooms   Int          @default(0) @map("blocked_rooms")
  reservedRooms  Int          @default(0) @map("reserved_rooms")
  availableRooms Int          @default(0) @map("available_rooms")
  stopSell       Boolean      @default(false) @map("stop_sell")
  closedToArrival Boolean     @default(false) @map("closed_to_arrival")
  closedToDeparture Boolean   @default(false) @map("closed_to_departure")
  minStay        Int?         @map("min_stay")
  maxStay        Int?         @map("max_stay")
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomCategory   RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([propertyId, roomCategoryId, stayDate])
  @@index([propertyId, stayDate])
  @@index([roomCategoryId, stayDate])
  @@map("inventory_calendar")
}

model InventoryBlock {
  id              String       @id @default(uuid()) @db.Uuid
  propertyId      String       @map("property_id") @db.Uuid
  roomCategoryId  String       @map("room_category_id") @db.Uuid
  fromDate        DateTime     @map("from_date") @db.Date
  toDate          DateTime     @map("to_date") @db.Date
  blockedRooms    Int          @default(1) @map("blocked_rooms")
  reason          String       @db.VarChar(180)
  source          String       @default("MANUAL") @db.VarChar(40)
  googleCalendarId String?      @map("google_calendar_id") @db.VarChar(255)
  googleCalendarEventId String? @map("google_calendar_event_id") @db.VarChar(255)
  googleCalendarHtmlLink String? @map("google_calendar_html_link") @db.Text
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomCategory    RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([propertyId, fromDate, toDate])
