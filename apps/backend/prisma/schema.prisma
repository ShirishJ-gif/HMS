  property       Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@index([propertyId])
  @@index([type])
  @@map("background_jobs")
}
